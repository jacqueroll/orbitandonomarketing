Options -Indexes
DirectoryIndex index.html

ErrorDocument 404 /404.html

RewriteEngine On
RewriteBase /

# Servir arquivo real se existir
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# URL limpa → .html (ex: /contato → /contato.html)
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^/]+)/?$ /$1.html [L]

# URL limpa em subpastas → .html (ex: /insights/nome-artigo → /insights/nome-artigo.html)
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+[^/])/?$ /$1.html [L]
